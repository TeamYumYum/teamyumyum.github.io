---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, CONTEXTS, SITE } from '../site.config';
import { getVisiblePosts } from '../lib/posts';

const posts = await getVisiblePosts();
const members = (await getCollection('authors')).filter((a) => a.data.member);
---

<BaseLayout title={SITE.title}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="copy">
        <p class="eyebrow">{SITE.team} 기술 블로그</p>
        <h1>{SITE.statement}</h1>
        <p class="lead">{SITE.lead}</p>
        <div class="actions">
          <a class="btn primary" href="/posts">글 읽으러 가기</a>
          <a class="btn" href="/team">팀 만나기</a>
        </div>
      </div>
      <div class="art" aria-hidden="true">
        <Mascot pose="wave" size={260} eager />
        <div class="bubble">오늘 점심 기록해 뒀어요!</div>
      </div>
    </div>
  </section>

  <section class="container latest" aria-labelledby="latest-title">
    <div class="latest-head">
      <h2 id="latest-title" class="section-title">새로 올라온 글</h2>
      <div class="tabs" role="tablist" aria-label="분류">
        <button class="chip" role="tab" aria-selected="true" data-filter="all">전체</button>
        {CATEGORIES.map((c) => (
          <button class="chip" role="tab" aria-selected="false" data-filter={c.id}>{c.name}</button>
        ))}
      </div>
    </div>
    {posts.length === 0
      ? <p class="empty">아직 글이 없어요. 곧 첫 글로 찾아올게요.</p>
      : (
        <div class="feed">
          {posts.map((p) => <div class="item" data-cat={p.data.category}><PostCard post={p} /></div>)}
        </div>
      )}
    <p class="empty filtered" hidden>이 분류의 첫 글을 준비하고 있어요.</p>
  </section>

  <section class="container team" aria-labelledby="team-title">
    <div class="team-card">
      <div>
        <h2 id="team-title" class="section-title">{members.length}명이 도메인 하나씩, 화면부터 DB까지</h2>
        <p>
          꾸기 팀은 기능을 화면·서버로 나누지 않고 도메인으로 나눠요. 회원, 식단, 운동, 코칭, 성장, 검수를
          한 명씩 맡아 폰 화면부터 API와 테이블까지 끝까지 책임집니다.
        </p>
        <a class="btn primary" href="/team">팀 소개 보기</a>
      </div>
      <ul class="contexts">
        {CONTEXTS.map((c) => <li><strong>{c.name}</strong><span>{c.id}</span></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  // 탭을 누르면 페이지를 옮기지 않고 그 분류의 글만 남긴다
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tabs [data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.feed .item');
  const filteredEmpty = document.querySelector<HTMLElement>('.empty.filtered')!;
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const f = tab.dataset.filter;
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    let shown = 0;
    items.forEach((el) => {
      el.hidden = !(f === 'all' || el.dataset.cat === f);
      if (!el.hidden) shown++;
    });
    filteredEmpty.hidden = shown > 0;
  }));
</script>

<style>
  .hero { background: linear-gradient(180deg, var(--brand-weak), var(--bg)); padding-block: var(--space-12) var(--space-10); }
  .hero-inner { display: grid; gap: var(--space-8); align-items: center; }
  .eyebrow { margin: 0 0 var(--space-3); color: var(--brand-text); font-weight: 800; font-size: var(--fs-300); }
  h1 { margin: 0; font-size: var(--fs-display); line-height: var(--lh-tight); letter-spacing: -0.03em; white-space: pre-line; }
  .lead { margin: var(--space-5) 0 0; color: var(--text-dim); font-size: var(--fs-500); line-height: var(--lh-snug); max-width: 36ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }

  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    height: 48px; padding: 0 var(--space-6); border-radius: var(--radius-md);
    background: var(--bg-sub); color: var(--text); font-weight: 700; font-size: var(--fs-300);
    transition: filter var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .btn:hover { filter: brightness(0.96); }
  .btn:active { transform: scale(0.98); }
  .btn.primary { background: var(--brand); color: var(--on-brand); }

  /* 마스코트를 글 쪽에 붙이고, 말풍선 꼬리가 꾸기의 부리를 가리키게 한다 */
  .art { position: relative; justify-self: center; padding: var(--space-10) var(--space-4) 0 0; }
  .art :global(.mascot) { width: min(260px, 56vw); height: auto; animation: bob 3.2s ease-in-out infinite; filter: drop-shadow(0 16px 24px rgb(0 0 0 / 0.08)); }
  .bubble {
    position: absolute; top: 0; right: 55%; z-index: 1;
    padding: var(--space-3) var(--space-4); border-radius: var(--radius-lg);
    background: var(--bg-elev); box-shadow: var(--shadow-card-hover); font-weight: 700; font-size: var(--fs-300); white-space: nowrap;
  }
  .bubble::after {
    content: ''; position: absolute; right: 18px; bottom: -7px; width: 14px; height: 14px;
    background: inherit; transform: rotate(45deg); border-radius: 0 0 4px 0;
  }
  @keyframes bob { 50% { transform: translateY(-8px); } }

  @media (min-width: 860px) {
    .hero-inner { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-16); }
    .art { justify-self: end; margin-right: var(--space-8); }
  }

  .latest { margin-top: var(--space-6); }
  .latest-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-8); }
  .latest-head .section-title { margin: 0; }
  .tabs { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .tabs .chip { border: 0; cursor: pointer; font-family: inherit; }
  .tabs .chip[aria-selected='true'] { background: var(--text); color: var(--bg); }

  .feed { display: grid; gap: var(--space-16) var(--space-10); grid-template-columns: 1fr; }
  @media (min-width: 720px) { .feed { grid-template-columns: repeat(2, 1fr); } }
  .item[hidden] { display: none; }
  .empty { color: var(--text-subtle); text-align: center; padding: var(--space-12) 0; }

  .team { margin-top: var(--space-20); }
  .team-card {
    display: grid; gap: var(--space-8); padding: var(--space-8);
    border-radius: var(--radius-lg); background: var(--bg-sub);
  }
  .team-card p { color: var(--text-dim); margin: 0 0 var(--space-6); max-width: 46ch; }
  .contexts { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
  .contexts li { display: flex; flex-direction: column; padding: var(--space-4); border-radius: var(--radius-md); background: var(--bg-elev); }
  .contexts strong { font-size: var(--fs-400); }
  .contexts span { color: var(--text-subtle); font-size: var(--fs-200); }
  @media (min-width: 860px) {
    .team-card { grid-template-columns: 1.2fr 1fr; align-items: center; padding: var(--space-12); }
    .contexts { grid-template-columns: repeat(3, 1fr); }
  }
</style>
