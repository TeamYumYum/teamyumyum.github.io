---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
import PostCard from '../components/PostCard.astro';
import PostGrid from '../components/PostGrid.astro';
import { CATEGORIES, CONTEXTS, SITE } from '../site.config';
import { getVisiblePosts } from '../lib/posts';

const posts = await getVisiblePosts();
const [featured, ...rest] = posts;
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.id, posts.filter((p) => p.data.category === c.id).length]));
const members = (await getCollection('authors')).filter((a) => a.data.member);
---

<BaseLayout title={SITE.title}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="copy">
        <p class="eyebrow">{SITE.team} 기술 블로그</p>
        <h1>{SITE.statement}</h1>
        <p class="lead">{SITE.lead}</p>
        <div class="actions">
          <a class="btn primary" href="/posts">글 읽으러 가기</a>
          <a class="btn" href="/team">팀 만나기</a>
        </div>
      </div>
      <div class="art" aria-hidden="true">
        <div class="bubble">오늘 점심 기록해 뒀어요!</div>
        <Mascot pose="wave" size={300} eager />
      </div>
    </div>
  </section>

  <section class="container cats" aria-label="분류">
    {CATEGORIES.map((c) => (
      <a class="cat" href={`/category/${c.id}`} data-cat={c.id}>
        <span class="cat-name">{c.name}</span>
        <span class="cat-desc">{c.description}</span>
        <span class="cat-count">{counts[c.id]}개의 글</span>
      </a>
    ))}
  </section>

  <section class="container latest" aria-labelledby="latest-title">
    <h2 id="latest-title" class="section-title">새로 올라온 글</h2>
    {featured && <div class="featured"><PostCard post={featured} featured /></div>}
    <PostGrid posts={rest} empty={featured ? '다음 글을 준비하고 있어요.' : undefined} />
  </section>

  <section class="container team" aria-labelledby="team-title">
    <div class="team-card">
      <div>
        <h2 id="team-title" class="section-title">{members.length}명이 도메인 하나씩, 화면부터 DB까지</h2>
        <p>
          꾸기 팀은 기능을 화면·서버로 나누지 않고 도메인으로 나눠요. 회원, 식단, 운동, 코칭, 성장, 검수를
          한 명씩 맡아 폰 화면부터 API와 테이블까지 끝까지 책임집니다.
        </p>
        <a class="btn primary" href="/team">팀 소개 보기</a>
      </div>
      <ul class="contexts">
        {CONTEXTS.map((c) => <li><strong>{c.name}</strong><span>{c.id}</span></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { background: linear-gradient(180deg, var(--brand-weak), var(--bg)); padding-block: var(--space-16) var(--space-12); }
  .hero-inner { display: grid; gap: var(--space-10); align-items: center; grid-template-columns: 1fr; }
  .eyebrow { margin: 0 0 var(--space-3); color: var(--brand-text); font-weight: 800; font-size: var(--fs-300); }
  h1 { margin: 0; font-size: var(--fs-display); line-height: var(--lh-tight); letter-spacing: -0.03em; white-space: pre-line; }
  .lead { margin: var(--space-5) 0 0; color: var(--text-dim); font-size: var(--fs-500); line-height: var(--lh-snug); max-width: 36ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }

  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    height: 48px; padding: 0 var(--space-6); border-radius: var(--radius-md);
    background: var(--bg-sub); color: var(--text); font-weight: 700; font-size: var(--fs-300);
    transition: filter var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .btn:hover { filter: brightness(0.96); }
  .btn:active { transform: scale(0.98); }
  .btn.primary { background: var(--brand); color: var(--on-brand); }

  .art { position: relative; display: flex; justify-content: center; padding-top: var(--space-12); }
  .art :global(.mascot) { width: min(300px, 64vw); height: auto; animation: bob 3.2s ease-in-out infinite; filter: drop-shadow(0 16px 24px rgb(0 0 0 / 0.08)); }
  .bubble {
    position: absolute; top: 0; left: 50%; transform: translateX(-90%); z-index: 1;
    padding: var(--space-3) var(--space-4); border-radius: var(--radius-lg) var(--radius-lg) var(--radius-lg) 4px;
    background: var(--bg-elev); box-shadow: var(--shadow-card-hover); font-weight: 700; font-size: var(--fs-300); white-space: nowrap;
  }
  @keyframes bob { 50% { transform: translateY(-8px); } }

  @media (min-width: 860px) {
    .hero { padding-block: var(--space-20); }
    .hero-inner { grid-template-columns: 1.3fr 1fr; }
    .art { padding-top: var(--space-16); }
  }

  .cats { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); margin-top: var(--space-4); }
  .cat {
    display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-5);
    border-radius: var(--radius-lg); transition: transform var(--dur) var(--ease);
  }
  .cat:hover { transform: translateY(-3px); }
  .cat[data-cat='tech'] { background: var(--cat-tech-bg); --c: var(--cat-tech-fg); }
  .cat[data-cat='troubleshooting'] { background: var(--cat-troubleshooting-bg); --c: var(--cat-troubleshooting-fg); }
  .cat[data-cat='culture'] { background: var(--cat-culture-bg); --c: var(--cat-culture-fg); }
  .cat[data-cat='news'] { background: var(--cat-news-bg); --c: var(--cat-news-fg); }
  .cat-name { color: var(--c); font-weight: 800; font-size: var(--fs-500); }
  .cat-desc { color: var(--text-dim); font-size: var(--fs-300); }
  .cat-count { margin-top: var(--space-2); color: var(--text-subtle); font-size: var(--fs-200); font-weight: 600; }

  .latest { margin-top: var(--space-16); }
  .featured { margin-bottom: var(--space-6); }

  .team { margin-top: var(--space-20); }
  .team-card {
    display: grid; gap: var(--space-8); padding: var(--space-8);
    border-radius: var(--radius-lg); background: var(--bg-sub);
  }
  .team-card p { color: var(--text-dim); margin: 0 0 var(--space-6); max-width: 46ch; }
  .contexts { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
  .contexts li { display: flex; flex-direction: column; padding: var(--space-4); border-radius: var(--radius-md); background: var(--bg-elev); }
  .contexts strong { font-size: var(--fs-400); }
  .contexts span { color: var(--text-subtle); font-size: var(--fs-200); }
  @media (min-width: 860px) {
    .team-card { grid-template-columns: 1.2fr 1fr; align-items: center; padding: var(--space-12); }
    .contexts { grid-template-columns: repeat(3, 1fr); }
  }
</style>
