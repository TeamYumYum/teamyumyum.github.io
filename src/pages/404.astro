---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
---

<BaseLayout title="페이지를 찾을 수 없어요">
  <div class="page w-read center">
    <Mascot pose="sleep" size={220} />
    <h1 class="page-title">쉿, 꾸기가 자는 곳이에요</h1>
    <p class="page-lead">주소가 바뀌었거나 아직 없는 글이에요.</p>
    <a class="home" href="/">홈으로 가기</a>
  </div>
</BaseLayout>

<style>
  .center { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-4); }
  .home { padding: 12px 24px; border-radius: var(--radius-md); background: var(--brand); color: var(--on-brand); font-weight: 700; }
</style>
