---
import type { MarkdownHeading } from 'astro';

interface Props { headings: MarkdownHeading[] }
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 1 && (
  <nav class="toc" aria-label="목차">
    <p class="label">목차</p>
    <ol>
      {items.map((h) => (
        <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc { font-size: var(--fs-200); line-height: var(--lh-snug); }
  .label { margin: 0 0 var(--space-3); color: var(--text-subtle); font-weight: 700; }
  ol { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--border); }
  li { margin: 0; }
  a { display: block; padding: 5px 0 5px var(--space-4); color: var(--text-dim); }
  a:hover { color: var(--brand-text); }
  .d3 a { padding-left: var(--space-8); }
</style>
