---
import type { Author } from '../lib/posts';

interface Props { authors: Author[]; size?: 'sm' | 'md' }
const { authors, size = 'sm' } = Astro.props;
---

<span class:list={['authors', size]}>
  {authors.map((a) => (
    <a class="author" href={`/authors/${a.id}`}>
      {a.data.github
        ? <img src={`https://github.com/${a.data.github}.png?size=64`} alt="" width="24" height="24" loading="lazy" />
        : <span class="initial" aria-hidden="true">{a.data.name.slice(0, 1)}</span>}
      <span class="name">{a.data.name}</span>
    </a>
  ))}
</span>

<style>
  .authors { display: inline-flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
  .author { display: inline-flex; align-items: center; gap: 6px; color: var(--text-dim); font-weight: 600; }
  .author:hover .name { color: var(--text); }
  img, .initial { width: 22px; height: 22px; border-radius: 50%; flex: none; }
  .initial {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--brand-weak); color: var(--brand-text); font-size: var(--fs-100); font-weight: 800;
  }
  .sm { font-size: var(--fs-200); }
  .md { font-size: var(--fs-300); }
  .md img, .md .initial { width: 28px; height: 28px; }
</style>
