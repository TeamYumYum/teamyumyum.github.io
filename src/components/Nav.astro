---
import { SITE } from '../site.config';
import Mascot from './Mascot.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/posts', label: '글' },
  { href: '/team', label: '팀' },
  { href: '/about', label: '꾸기' },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href="/" aria-label={`${SITE.title} 홈`}>
      <Mascot size={30} eager />
      <span>{SITE.title}</span>
    </a>
    <nav aria-label="주 메뉴">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <a class="icon" href="/search" aria-label="검색">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M20 20l-4.2-4.2"></path></svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.6) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease);
  }
  :global(html.scrolled) .site-header { border-bottom-color: var(--border); }

  .bar { display: flex; align-items: center; gap: var(--space-6); height: 64px; }
  .logo { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 800; font-size: var(--fs-500); letter-spacing: -0.02em; }

  nav { flex: 1; }
  ul { display: flex; gap: var(--space-1); list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block; padding: 6px 12px; border-radius: var(--radius-pill);
    color: var(--text-dim); font-weight: 600; font-size: var(--fs-300);
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  nav a:hover { color: var(--text); background: var(--bg-sub); }
  nav a[aria-current='page'] { color: var(--brand-text); }

  .tools { display: flex; align-items: center; gap: var(--space-1); }
  .icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: var(--radius-pill); color: var(--text-dim);
  }
  .icon:hover { color: var(--text); background: var(--bg-sub); }

  @media (max-width: 560px) {
    .bar { gap: var(--space-3); }
    .logo span { display: none; }
    nav a { padding: 6px 10px; }
  }
</style>
