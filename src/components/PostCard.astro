---
/*
 * 글 카드. 테두리 없이 둥근 커버 아래에 제목·글쓴이를 두고, 맨 아래에 분류와 태그 칩을 붙인다.
 * 설명(부제)은 글 안에서만 보여 준다. 커버는 글마다 반드시 있다(scripts/make-cover.mjs). 사진 비율이 달라도 16:9로 잘라 한 줄의 높이를 맞춘다.
 */
import { Image } from 'astro:assets';
import { getCategory } from '../site.config';
import { formatDate, getPostAuthors, tagSlug, type Post } from '../lib/posts';
import AuthorChips from './AuthorChips.astro';

interface Props { post: Post }
const { post } = Astro.props;
const category = getCategory(post.data.category);
const authors = await getPostAuthors(post);
const href = `/posts/${post.id}`;
---

<article class="card">
  <a class="cover" href={href} tabindex="-1" aria-hidden="true">
    <Image src={post.data.cover} alt="" widths={[640, 1280]} sizes="(max-width: 720px) 100vw, 560px" />
  </a>
  <div class="body">
    <h3><a href={href}>{post.data.title}{post.data.draft && <span class="draft">초안</span>}</a></h3>
    <div class="meta">
      <AuthorChips authors={authors} />
      <span class="dot" aria-hidden="true">·</span>
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    </div>
    <ul class="chips">
      <li><a class="badge" data-cat={category.id} href={`/category/${category.id}`}>{category.name}</a></li>
      {post.data.tags.slice(0, 3).map((t) => <li><a class="tag" href={`/tags/${tagSlug(t)}`}>{t}</a></li>)}
    </ul>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; }

  .cover { display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-lg); background: var(--bg-sub); }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease); }
  .card:hover .cover :global(img) { transform: scale(1.03); }

  .body { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-5) var(--space-2) 0; }
  h3 { margin: 0; font-size: var(--fs-600); line-height: var(--lh-snug); letter-spacing: -0.02em; }
  h3 a:hover, .card:hover h3 a { color: var(--brand-text); }
  .draft {
    margin-left: var(--space-2); vertical-align: middle;
    font-size: var(--fs-100); font-weight: 700; color: var(--text-subtle);
    border: 1px dashed var(--text-subtle); border-radius: var(--radius-pill); padding: 1px 8px;
  }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; color: var(--text-subtle); font-size: var(--fs-200); }

  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; margin: var(--space-3) 0 0; padding: 0; }
  .tag {
    display: inline-block; padding: 3px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm);
    color: var(--text-dim); font-size: var(--fs-200); font-weight: 600;
  }
  .tag:hover { color: var(--text); border-color: var(--text-subtle); }
  .chips .badge { border-radius: var(--radius-sm); padding: 3px 10px; }
</style>
