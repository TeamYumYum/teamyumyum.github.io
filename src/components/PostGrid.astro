---
import type { Post } from '../lib/posts';
import PostCard from './PostCard.astro';
import Mascot from './Mascot.astro';

interface Props { posts: Post[]; empty?: string }
const { posts, empty = '아직 글이 없어요. 곧 첫 글로 찾아올게요.' } = Astro.props;
---

{posts.length === 0
  ? <div class="empty empty-state"><Mascot pose="f-calm" size={96} /><p>{empty}</p></div>
  : (
    <div class="grid">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  )}

<style>
  .empty-state { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); }
  .empty-state p { margin: 0; }
  .grid { display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
</style>
