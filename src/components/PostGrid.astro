---
import type { Post } from '../lib/posts';
import PostCard from './PostCard.astro';
import Mascot from './Mascot.astro';

interface Props { posts: Post[]; empty?: string }
const { posts, empty = '아직 글이 없어요. 곧 첫 글로 찾아올게요.' } = Astro.props;
---

{posts.length === 0
  ? <div class="empty empty-state"><Mascot pose="f-calm" size={96} /><p>{empty}</p></div>
  : (
    <div class="grid">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  )}

<style>
  .empty-state { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); }
  .empty-state p { margin: 0; }
  /* 한 줄에 두 개. 카드에 테두리가 없으므로 간격으로 글을 나눈다 */
  .grid { display: grid; gap: var(--space-16) var(--space-10); grid-template-columns: 1fr; }
  @media (min-width: 720px) { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
